NODE_ENV=development
PORT=3000
# The only website allowed to call this API (CORS) and the base of QR code links
FRONTEND_URL=http://localhost:5173

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartqr
DB_USER=smartqr_user
DB_PASSWORD=change_me
# Used only when NODE_ENV=test
DB_NAME_TEST=smartqr_test

# Authentication
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Set to true only for local load testing
RATE_LIMIT_DISABLED=false
